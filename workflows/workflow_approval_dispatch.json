        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unrouted Channel": {
      "main": [
        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release Agent": {
