{
  "name": "Approval Dispatch",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-dispatch",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "webhookId": "approval-dispatch",
      "notes": "The backend calls this only after an approval row has committed as APPROVED."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "email"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "meta_dm"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "meta_dm"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "shopee"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "shopee"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unrouted"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Route By Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Send Email — PLACEHOLDER",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -140,
        120
      ],
      "notes": "Replace with an SMTP / Gmail node. Subject and body are in payload.draft."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.body.payload.recipient }, messaging_type: 'RESPONSE', message: { text: $json.body.payload.draft } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Send Messenger Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        260
      ],
      "notes": "Sends the approved text to the customer's Messenger thread. The 24-hour standard messaging window applies; outside it you need a message tag."
    },
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Unrouted Channel",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -140,
        540
      ],
      "notes": "Unknown channel: nothing is sent. The approval row stays APPROVED and the log shows no dispatch."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/agents/{{ $('Approval Webhook').item.json.body.agent_id }}/release",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'IDLE', message: 'Dispatched' }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{ $env.INTERNAL_TOKEN }}"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Release Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        300
      ],
      "notes": "Releasing never moves a PAUSED agent — the backend guards that."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, dispatched: true }) }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000008",
      "name": "Respond Dispatched",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Shopee's Seller Chat, signed the same way as any other shop API:\n//   partner_id + api_path + timestamp + access_token + shop_id\n// HMAC-SHA256 under the partner key. Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto.\nconst crypto = require('crypto');\n\nconst partnerId = Number($env.SHOPEE_PARTNER_ID);\nconst partnerKey = $env.SHOPEE_PARTNER_KEY;\nconst shopId = Number($env.SHOPEE_SHOP_ID);\nconst accessToken = $env.SHOPEE_ACCESS_TOKEN;\nconst host = $env.SHOPEE_HOST || 'https://partner.shopeemobile.com';\n\nconst payload = $input.first().json.body.payload;\nconst missing = [];\nif (!partnerId) missing.push('SHOPEE_PARTNER_ID');\nif (!partnerKey) missing.push('SHOPEE_PARTNER_KEY');\nif (!shopId) missing.push('SHOPEE_SHOP_ID');\nif (!accessToken) missing.push('SHOPEE_ACCESS_TOKEN');\nif (missing.length) {\n  throw new Error('Shopee is not configured: ' + missing.join(', ') + ' are unset.');\n}\nif (!payload.recipient) {\n  throw new Error('No Shopee buyer id on this approval, so there is nobody to reply to.');\n}\n\nconst path = '/api/v2/sellerchat/send_message';\nconst timestamp = Math.floor(Date.now() / 1000);\nconst base = `${partnerId}${path}${timestamp}${accessToken}${shopId}`;\nconst sign = crypto.createHmac('sha256', partnerKey).update(base).digest('hex');\n\nreturn [{ json: {\n  url: `${host}${path}?partner_id=${partnerId}&timestamp=${timestamp}`\n     + `&access_token=${accessToken}&shop_id=${shopId}&sign=${sign}`,\n  payload: {\n    to_id: Number(payload.recipient),\n    message_type: 'text',\n    content: { text: payload.draft },\n  },\n} }];"
      },
      "id": "b1000000-0000-4000-8000-000000000010",
      "name": "Sign Shopee Chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        400
      ],
      "notes": "payload.recipient is the buyer's Shopee user id, carried through from the message that started the run."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "b1000000-0000-4000-8000-000000000011",
      "name": "Send Shopee Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        400
      ],
      "notes": "POST /api/v2/sellerchat/send_message."
    }
  ],
  "connections": {
    "Approval Webhook": {
      "main": [
        [
          {
