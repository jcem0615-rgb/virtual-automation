{
  "name": "Approval Dispatch",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-dispatch",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "webhookId": "approval-dispatch",
      "notes": "The backend calls this only after an approval row has committed as APPROVED."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "email"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "meta_dm"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "meta_dm"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.payload.channel }}",
                    "rightValue": "shopee"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "shopee"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unrouted"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Route By Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Send Email — PLACEHOLDER",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -140,
        120
      ],
      "notes": "Replace with an SMTP / Gmail node. Subject and body are in payload.draft."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.body.payload.recipient }, messaging_type: 'RESPONSE', message: { text: $json.body.payload.draft } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Send Messenger Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        260
      ],
      "notes": "Sends the approved text to the customer's Messenger thread. The 24-hour standard messaging window applies; outside it you need a message tag."
    },
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Send Shopee Reply — PLACEHOLDER",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -140,
        400
      ],
      "notes": "Replace with the Shopee Open Platform chat endpoint."
    },
    {
      "parameters": {},
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Unrouted Channel",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -140,
        540
      ],
      "notes": "Unknown channel: nothing is sent. The approval row stays APPROVED and the log shows no dispatch."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/agents/{{ $('Approval Webhook').item.json.body.agent_id }}/release",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'IDLE', message: 'Dispatched' }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{ $env.INTERNAL_TOKEN }}"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Release Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        300
      ],
      "notes": "Releasing never moves a PAUSED agent — the backend guards that."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, dispatched: true }) }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000008",
      "name": "Respond Dispatched",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        380,
        300
      ]
    }
  ],
  "connections": {
    "Approval Webhook": {
      "main": [
        [
          {
            "node": "Route By Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route By Channel": {
      "main": [
        [
          {
            "node": "Send Email — PLACEHOLDER",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Messenger Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Shopee Reply — PLACEHOLDER",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Unrouted Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email — PLACEHOLDER": {
      "main": [
        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Shopee Reply — PLACEHOLDER": {
      "main": [
        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unrouted Channel": {
      "main": [
        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release Agent": {
      "main": [
        [
          {
            "node": "Respond Dispatched",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Messenger Reply": {
      "main": [
        [
          {
            "node": "Release Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "virtual-office-dev"
  }
}
