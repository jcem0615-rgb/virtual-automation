# Backend configuration. docker-compose.yml supplies these for the stack;
# copy to backend/.env when running `npm run dev` on its own.
DATABASE_URL=postgres://office:office@localhost:5432/virtual_office
PORT=4000

# Shared with n8n. /api/internal/* rejects anything without this header.
INTERNAL_TOKEN=dev-internal-token

# n8n webhooks the backend calls back into.
N8N_RETRY_WEBHOOK_URL=http://localhost:5678/webhook/sales-lead
N8N_DISPATCH_WEBHOOK_URL=http://localhost:5678/webhook/approval-dispatch
N8N_POST_SYNC_WEBHOOK_URL=http://localhost:5678/webhook/post-sync
