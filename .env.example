# Copy to .env before `docker compose up -d --build`.
POSTGRES_PASSWORD=office
INTERNAL_TOKEN=dev-internal-token
OLLAMA_MODEL=llama3.1

# --- only needed when deploying with docker-compose.prod.yml ---
# The port the dashboard is published on (put TLS in front of it).
HTTP_PORT=80
# Set false ONLY if you are serving over plain http, which sends the session
# cookie unencrypted. Leave it true behind HTTPS.
COOKIE_SECURE=true
# Number of proxies in front of the backend, for correct client IPs.
TRUST_PROXY=1
# How long a sign-in lasts.
SESSION_DAYS=7
# Public URL of your n8n instance, if webhooks are called from outside.
N8N_WEBHOOK_URL=https://n8n.example.com/
