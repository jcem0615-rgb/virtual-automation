# Copy to .env before `docker compose up -d --build`.
POSTGRES_PASSWORD=office
# Encrypts the marketplace credentials your sellers connect. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means every connected shop has to be reconnected.
CREDENTIALS_KEY=
INTERNAL_TOKEN=dev-internal-token
OLLAMA_MODEL=llama3.1

# --- only needed when deploying with docker-compose.prod.yml ---
# The port the dashboard is published on (put TLS in front of it).
HTTP_PORT=80
# Set false ONLY if you are serving over plain http, which sends the session
# cookie unencrypted. Leave it true behind HTTPS.
COOKIE_SECURE=true
# Number of proxies in front of the backend, for correct client IPs.
TRUST_PROXY=1
# How long a sign-in lasts.
SESSION_DAYS=7
# Public URL of your n8n instance, if webhooks are called from outside.
N8N_WEBHOOK_URL=https://n8n.example.com/

# --- connecting a Facebook / Instagram page (optional) ---
# A string you invent; Meta echoes it back when you subscribe the webhook.
META_VERIFY_TOKEN=
# App secret from the Meta app dashboard. Used to verify every delivery.
META_APP_SECRET=
# Page access token with pages_messaging. This can send as your page — treat
# it like a password.
META_PAGE_ACCESS_TOKEN=
# Which business the page's messages belong to.
META_BUSINESS_CODE=BIZ_ELEC
# Page id, needed to publish a NEW post (editing one only needs the post id).
META_PAGE_ID=

# --- Shopee (optional) ---
# From the Shopee Open Platform console. The access token is per shop and
# expires every few hours, so refresh it on a schedule.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
# Regional host, or the sandbox: https://partner.test-stable.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com

# --- TikTok (optional) ---
# Content Posting API token. Needs video.publish / photo.publish, an audited
# app, and the media URL's domain verified with TikTok.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# ---------------------------------------------------------------- connecting
# Connecting a shop is an authorization the seller gives on the marketplace's
# own site. These are the deployment's app credentials — one set for everyone,
# not per business — and the address the marketplace sends the seller back to.
#
# OAUTH_REDIRECT_BASE must be the origin the DASHBOARD is served from, because
# the redirect is a top-level navigation that has to carry the session cookie.
# Register exactly <base>/api/accounts/callback with each platform.
OAUTH_REDIRECT_BASE=https://office.example.com

# Shopee Open Platform (partner id and the partner key, not a shop's keys)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Lazada Open Platform
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
# TikTok Shop Partner Center. SERVICE_ID is the one on the authorization url.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Meta app, for Messenger and Instagram pages
META_APP_ID=
META_APP_SECRET=
